{
  "name": "hangshuo-personal-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9 <25"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "6.19.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "5.7.3",
    "tsx": "4.19.4",
    "@types/node": "22.15.30",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.6",
    "autoprefixer": "10.4.20"
  }
}
